<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-feed-table" author="feed_user">
        <createTable tableName="feed">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pin_id" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="media_url" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="media_width" type="INT"/>
            <column name="media_height" type="INT"/>
            <column name="embedding" type="vector(1152)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="feed"/>
        </rollback>
    </changeSet>

    <changeSet id="create-feed-hnsw-index" author="feed_user">
        <sql>
            CREATE INDEX IF NOT EXISTS idx_feed_embedding_hnsw
                ON feed
                USING hnsw (embedding vector_cosine_ops);
        </sql>
        <rollback>
            DROP INDEX IF EXISTS idx_feed_embedding_hnsw;
        </rollback>
    </changeSet>

</databaseChangeLog>